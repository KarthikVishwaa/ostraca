# Copy to .env and fill in. NEVER commit .env.

# --- PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox → your app) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=
# Same Client ID, exposed to the browser for the checkout buttons (safe to expose):
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# From your app's Webhooks section after you add https://<your-app>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# --- Database: free Neon Postgres (neon.tech) connection string ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- AI ---
# Claude reads receipts, invoices, screenshots and PDFs (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# OpenAI transcribes voice notes in Tamil / Hindi / English (platform.openai.com)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

APP_URL=http://localhost:3000

# --- Limits ---
# Most AI calls (Claude + speech) the whole app may make per UTC day. Past it, AI routes answer 429.
AI_DAILY_CALL_CAP=300
# Content-Security-Policy: leave unset to only REPORT violations; set to "enforce" once /store checkout shows none.
CSP_MODE=
# Reverse proxies in front of the app. Render = 1. Used to read the real client IP from X-Forwarded-For (counted from the right).
TRUSTED_PROXY_HOPS=1
